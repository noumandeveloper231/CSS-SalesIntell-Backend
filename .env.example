# ── ZOOMINFO ────────────────────────────────────────────────
ZOOM_INFO_CLIENT_ID=your_client_id_here
ZOOM_INFO_USERNAME=your.zoominfo.login@company.com
ZOOM_INFO_API_KEY=your_private_key_here_base64_or_pem
ZOOMINFO_AUTH_TYPE=jwt

# ── ANTHROPIC CLAUDE ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── MS POWER AUTOMATE ───────────────────────────────────────
POWER_AUTOMATE_WEBHOOK=

# ── MICROSOFT GRAPH (email sending) ──────────────────────────
MS_CLIENT_ID=your_azure_client_id
MS_CLIENT_SECRET=your_azure_client_secret
MS_TENANT_ID=your_azure_tenant_id
MS_SENDER_EMAIL=sender@yourcompany.com
MS_REDIRECT_URI=https://api-salesintell.duckdns.org/auth/callback

# Testing: ROUTE_EMAIL=true sends ALL mail to EMAIL instead of prospects.
ROUTE_EMAIL=true
EMAIL=your-test-email@company.com

# ── CSS STAFFING CONFIG ──────────────────────────────────────
CSS_SENDER_NAME=Your Company Name
CSS_SENDER_EMAIL=sender@yourcompany.com
CSS_PHONE=(555) 123-4567
CSS_WEBSITE=https://www.yourcompany.com

# ── APP ──────────────────────────────────────────────────────
PORT=5000
APP_SECRET=generate_a_strong_random_secret_here
NODE_ENV=production

# ── SECURITY ─────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (leave blank to block all cross-origin)
# Example: CORS_ORIGINS=https://salesintell.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

# ── OUTREACH CONTROLS ────────────────────────────────────────
RECORDS_PER_HOUR=1000
EMAILS_PER_HOUR=20
EMAIL_SEND_START=08:00
EMAIL_SEND_END=17:00
TARGET_JOB_TYPES=Controller,HR Director,Staff Accountant,Payroll Manager,CFO

# ── DISCOVERY SETTINGS ───────────────────────────────────────
DISCOVERY_INDUSTRIES=ALL
DISCOVERY_STATES=ALL
JOB_RESCAN_HOURS=24
MAX_JOBS_PER_COMPANY=5

# ── OPTIONAL KEYS ────────────────────────────────────────────
OPENROUTER_API_KEY=
DISCOVERY_ENABLED=false
JOB_SCAN_ENABLED=false
EMAIL_ENABLED=false
